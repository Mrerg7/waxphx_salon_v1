---
import type { CollectionEntry } from 'astro:content';

interface Props {
  content: CollectionEntry<'site'>;
}

const { content } = Astro.props;
const { why } = content.data;
---

<section id="why" class="max-w-screen-xl mx-auto px-6 py-24 border-b border-terracotta/10">
  <div class="grid md:grid-cols-12 gap-16 items-center">
    <div class="md:col-span-7">
      <div class="uppercase tracking-[3px] text-xs font-semibold text-terracotta mb-3">{why.label}</div>
      <h2 class="text-4xl sm:text-6xl font-display tracking-tighter leading-none mb-8 whitespace-pre-line text-stone-800">
        {why.title}
      </h2>
      <div class="space-y-6 text-lg text-stone-500 max-w-[38ch]">
        {why.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <div class="md:col-span-5 space-y-4">
      {
        why.cards.map((card, index) => (
          <div class="glass p-6 rounded-3xl">
            <div class="flex justify-between items-start mb-4">
              <div>
                <div class="text-sm text-stone-400">{card.label}</div>
                <div class="text-3xl font-semibold mt-1 text-stone-800">{card.title}</div>
              </div>
              {index === 0 ? (
                <svg class="w-10 h-10 text-terracotta/40" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              ) : index === 1 ? (
                <svg class="w-10 h-10 text-sage/40" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              ) : (
                <svg class="w-10 h-10 text-desert/40" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
              )}
            </div>
            <p class="text-sm text-stone-500">{card.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
