---
import type { CollectionEntry } from 'astro:content';

interface Props {
  content: CollectionEntry<'site'>;
}

const { content } = Astro.props;
const { useCases } = content.data;
---

<section id="usecases" class="max-w-screen-xl mx-auto px-6 py-24 border-b border-terracotta/10">
  <div class="uppercase tracking-[3px] text-xs font-semibold text-terracotta mb-3">{useCases.label}</div>
  <h2 class="text-4xl sm:text-6xl font-display tracking-tighter leading-none mb-4 text-stone-800">
    {useCases.title}
  </h2>
  <p class="text-xl text-stone-500 mb-16">{useCases.subtitle}</p>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {useCases.items.map((item) => (
      <div class="use-case-card glass rounded-3xl p-8 flex flex-col">
        <div class={`inline-flex items-center px-3 py-1 rounded-full bg-gradient-to-r ${item.gradient} bg-opacity-10 text-xs font-semibold text-stone-800 mb-4 w-fit`}>
          {item.tag}
        </div>
        <h3 class="text-xl font-semibold text-stone-800 mb-2">{item.title}</h3>
        <p class="text-sm text-stone-500 leading-relaxed mb-4 flex-1">{item.description}</p>
        <div class="pt-4 border-t border-terracotta/10">
          <span class="text-[11px] text-stone-400 font-mono tracking-wide">{item.example}</span>
        </div>
      </div>
    ))}
  </div>
</section>
