---
import type { CollectionEntry } from 'astro:content';

interface Props {
  content: CollectionEntry<'site'>;
}

const { content } = Astro.props;
const { investment } = content.data;
---

<section id="investment" class="section-bg py-24 border-b border-terracotta/10">
  <div class="max-w-screen-xl mx-auto px-6">
    <div class="uppercase tracking-[3px] text-xs font-semibold text-terracotta mb-3">{investment.label}</div>
    <h2 class="text-4xl sm:text-6xl font-display tracking-tighter leading-none mb-16 whitespace-pre-line text-stone-800">
      {investment.title}
    </h2>

    <div class="grid sm:grid-cols-2 gap-6">
      {investment.pillars.map((pillar) => (
        <div class="glass rounded-3xl p-8 flex gap-6">
          <div class="text-4xl font-display text-terracotta/20 shrink-0 leading-none">{pillar.number}</div>
          <div>
            <h3 class="text-xl font-semibold text-stone-800 mb-2">{pillar.title}</h3>
            <p class="text-sm text-stone-500 leading-relaxed">{pillar.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
