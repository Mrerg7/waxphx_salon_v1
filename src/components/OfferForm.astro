---
import { SITE, acquisitionMailto } from '../constants/site';

const mailto = acquisitionMailto();
const email = SITE.email;
---

<section id="offer" class="section-bg border-y border-terracotta/10 scroll-mt-24">
  <div class="max-w-screen-xl mx-auto px-6 py-20 sm:py-24">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <div class="uppercase tracking-[3px] text-xs font-semibold text-terracotta mb-3">Private Offer</div>
        <h2 class="text-3xl sm:text-5xl font-display tracking-tighter leading-[1.05] mb-5 text-stone-800">
          Make an offer on <span class="gradient-text">waxphx.salon</span>
        </h2>
        <p class="text-lg text-stone-500 leading-relaxed mb-8 max-w-md">
          Tell us what you plan to build and what you are prepared to pay. Every inquiry is answered personally
          within 24 hours, and nothing is shared with third parties.
        </p>

        <ul class="space-y-4 mb-8">
          <li class="flex gap-x-3 items-start">
            <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-sm text-stone-600"><strong class="text-stone-800">Asking $50,000</strong> — reasonable offers from qualified buyers are considered.</span>
          </li>
          <li class="flex gap-x-3 items-start">
            <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-sm text-stone-600">Licensed third-party escrow, clean title, and assisted registrar transfer.</span>
          </li>
          <li class="flex gap-x-3 items-start">
            <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span class="text-sm text-stone-600">Installment structures available for qualified buyers.</span>
          </li>
        </ul>

        <div class="glass rounded-2xl p-5">
          <div class="text-xs uppercase tracking-[0.2em] text-stone-400 mb-1">Or email directly</div>
          <div class="flex flex-wrap items-center gap-3">
            <a
              href={mailto}
              class="inline-flex items-center min-h-[44px] text-lg sm:text-xl font-semibold text-terracotta hover:text-terracotta/80 break-all"
            >
              {email}
            </a>
            <button
              type="button"
              id="copy-email"
              data-email={email}
              class="px-4 min-h-[44px] text-xs font-semibold rounded-full border border-stone-300 text-stone-600 hover:border-terracotta hover:text-terracotta transition-colors"
            >
              Copy
            </button>
          </div>
          <p id="copy-status" class="text-xs text-emerald-600 mt-2 h-4" role="status" aria-live="polite"></p>
        </div>
      </div>

      <div class="lg:col-span-7 w-full">
        <form id="offer-form" class="glass rounded-3xl p-6 sm:p-8" novalidate>
          <div class="grid sm:grid-cols-2 gap-4 sm:gap-5">
            <div class="sm:col-span-1">
              <label for="offer-name" class="block text-sm font-medium text-stone-700 mb-1.5">Full name</label>
              <input
                type="text"
                id="offer-name"
                name="name"
                required
                autocomplete="name"
                placeholder="Jane Doe"
                class="w-full px-4 py-3 rounded-xl border border-stone-300 bg-white/90 text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-terracotta/40 focus:border-terracotta transition"
              />
            </div>

            <div class="sm:col-span-1">
              <label for="offer-email" class="block text-sm font-medium text-stone-700 mb-1.5">Email</label>
              <input
                type="email"
                id="offer-email"
                name="email"
                required
                autocomplete="email"
                placeholder="you@company.com"
                class="w-full px-4 py-3 rounded-xl border border-stone-300 bg-white/90 text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-terracotta/40 focus:border-terracotta transition"
              />
            </div>

            <div class="sm:col-span-1">
              <label for="offer-amount" class="block text-sm font-medium text-stone-700 mb-1.5">
                Your offer (USD)
              </label>
              <input
                type="number"
                id="offer-amount"
                name="amount"
                min="1000"
                step="500"
                inputmode="numeric"
                placeholder="50000"
                class="w-full px-4 py-3 rounded-xl border border-stone-300 bg-white/90 text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-terracotta/40 focus:border-terracotta transition"
              />
              <p class="text-xs text-stone-400 mt-1.5">Asking price is $50,000.</p>
            </div>

            <div class="sm:col-span-1">
              <label for="offer-use" class="block text-sm font-medium text-stone-700 mb-1.5">Intended use</label>
              <select
                id="offer-use"
                name="use"
                class="w-full px-4 py-3 rounded-xl border border-stone-300 bg-white/90 text-stone-800 focus:outline-none focus:ring-2 focus:ring-terracotta/40 focus:border-terracotta transition"
              >
                <option value="New salon or spa">New salon or spa</option>
                <option value="Existing business rebrand">Existing business rebrand</option>
                <option value="Mobile or at-home service">Mobile or at-home service</option>
                <option value="Booking platform or marketplace">Booking platform or marketplace</option>
                <option value="Training academy">Training academy</option>
                <option value="Domain investment or resale">Domain investment or resale</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div class="sm:col-span-2">
              <label for="offer-message" class="block text-sm font-medium text-stone-700 mb-1.5">
                Message <span class="text-stone-400 font-normal">(optional)</span>
              </label>
              <textarea
                id="offer-message"
                name="message"
                rows="4"
                placeholder="Tell us about your timeline, financing, or questions."
                class="w-full px-4 py-3 rounded-xl border border-stone-300 bg-white/90 text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-terracotta/40 focus:border-terracotta transition resize-y"
              ></textarea>
            </div>
          </div>

          <div class="mt-6 flex flex-col sm:flex-row sm:items-center gap-4">
            <button
              type="submit"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-x-3 px-8 py-4 bg-terracotta hover:bg-terracotta/80 text-white font-semibold rounded-2xl text-base shadow-lg shadow-terracotta/20 transition-all"
            >
              <span>Send Private Offer</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </button>
            <p class="text-xs text-stone-400 leading-relaxed">
              Opens your email app with the details pre-filled. Nothing is stored on this site.
            </p>
          </div>

          <p id="form-status" class="text-sm font-medium mt-4 h-5" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('offer-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const name = (document.getElementById('offer-name') as HTMLInputElement)?.value.trim() ?? '';
    const email = (document.getElementById('offer-email') as HTMLInputElement)?.value.trim() ?? '';
    const amount = (document.getElementById('offer-amount') as HTMLInputElement)?.value.trim() ?? '';
    const use = (document.getElementById('offer-use') as HTMLSelectElement)?.value ?? '';
    const message = (document.getElementById('offer-message') as HTMLTextAreaElement)?.value.trim() ?? '';

    if (!name || !email) {
      if (status) status.textContent = 'Please add your name and email so we can reply.';
      status?.classList.add('text-red-600');
      status?.classList.remove('text-emerald-600');
      return;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      if (status) status.textContent = 'That email address does not look valid.';
      status?.classList.add('text-red-600');
      status?.classList.remove('text-emerald-600');
      return;
    }

    const body = [
      'Hello,',
      '',
      'I would like to make an offer on waxphx.salon.',
      '',
      `Name: ${name}`,
      `Reply to: ${email}`,
      `Offer (USD): ${amount || 'Not specified'}`,
      `Intended use: ${use}`,
      '',
      message ? `Message:\n${message}` : 'Message: (none)',
      '',
      'Thank you.',
    ].join('\n');

    if (status) status.textContent = 'Opening your email app…';
    status?.classList.add('text-emerald-600');
    status?.classList.remove('text-red-600');

    window.location.href = `mailto:sales@desertrich.com?subject=${encodeURIComponent(
      `Offer for waxphx.salon — ${name}`,
    )}&body=${encodeURIComponent(body)}`;
  });

  const copyButton = document.getElementById('copy-email') as HTMLButtonElement | null;
  const copyStatus = document.getElementById('copy-status');

  copyButton?.addEventListener('click', async () => {
    const address = copyButton.dataset.email ?? '';
    try {
      await navigator.clipboard.writeText(address);
      if (copyStatus) copyStatus.textContent = 'Email address copied.';
    } catch {
      if (copyStatus) copyStatus.textContent = `Copy failed — email: ${address}`;
    }
  });
</script>
