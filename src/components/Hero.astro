---
import type { CollectionEntry } from 'astro:content';
import { acquisitionMailto, HERO_IMAGE } from '../constants/site';

interface Props {
  content: CollectionEntry<'site'>;
}

const { content } = Astro.props;
const { hero, domainPreview } = content.data;
const mailto = acquisitionMailto();
---

<section class="hero-bg min-h-screen flex items-center pt-16 relative">
  <div class="max-w-screen-xl mx-auto px-6 pt-12 pb-24">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="max-w-4xl">
        <div
          class="inline-flex items-center gap-x-2 px-4 py-1.5 rounded-full bg-white/80 border border-terracotta/20 mb-6"
        >
          <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
          <span class="uppercase tracking-[2px] text-xs font-semibold text-terracotta">{hero.badge}</span>
        </div>

        <h1 class="text-5xl sm:text-7xl md:text-[80px] leading-[0.96] font-display tracking-tighter mb-6 text-stone-800">
          {hero.headline} <span class="gradient-text">{hero.headlineAccent}</span>
        </h1>

        <p class="max-w-lg text-xl sm:text-2xl text-stone-500 mb-10">
          <span class="font-semibold text-stone-800">waxphx.salon</span>
          {" — Rare. Exact-match. Industry-perfect. The premier domain capturing body waxing, facial waxing, Brazilian waxing, men's grooming, and professional hair removal services across the Valley of the Sun."}
        </p>

        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <a
            href={mailto}
            class="group px-10 py-4 bg-terracotta hover:bg-terracotta/80 transition-all text-white font-semibold rounded-2xl flex items-center justify-center gap-x-3 text-lg shadow-xl shadow-terracotta/20"
          >
            <span>Inquire to Acquire</span>
            <svg class="w-5 h-5 group-active:scale-95 transition-transform" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
            </svg>
          </a>

          <a
            href="#why"
            class="group px-8 py-4 border border-stone-300 hover:border-terracotta rounded-2xl flex items-center gap-x-3 text-lg text-stone-600 hover:text-terracotta transition-all"
          >
            <span>See Why It Matters</span>
            <svg class="w-5 h-5 group-hover:translate-y-0.5 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </a>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-2 text-sm text-stone-500">
          <div class="flex items-center gap-x-2">
            <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span>Escrow protected</span>
          </div>
          <div class="flex items-center gap-x-2">
            <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM4.332 8.027a6.012 6.012 0 011.912 2.706C6.512 9.608 7.88 9.25 9 9.25s2.488.358 3.756 1.483a6.012 6.012 0 011.912-2.706C14.012 5.547 11.753 4.25 9 4.25S3.988 5.547 3.668 8.027z" clip-rule="evenodd"></path>
            </svg>
            <span>Instant transfer</span>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-5">
        <img
          src={HERO_IMAGE}
          alt="Luxury Phoenix-area spa interior with modern organic design — waxphx.salon premium domain"
          class="w-full rounded-3xl border border-terracotta/20 shadow-2xl shadow-terracotta/10 object-cover"
          width="1200"
          height="800"
          loading="eager"
          fetchpriority="high"
        />
        <div class="glass px-8 py-6 rounded-3xl w-full">
          <div class="flex items-center gap-x-3 mb-4">
            <div class="px-3 py-1 bg-white/80 rounded-full text-xs font-mono tracking-widest text-stone-600">{domainPreview.domain}</div>
          </div>
          <div class="text-sm text-stone-500">{domainPreview.description}</div>
          <div class="mt-4 pt-4 border-t border-terracotta/10 flex justify-between items-end gap-4">
            <div>
              <div class="text-xs text-stone-400">{domainPreview.valuationLabel}</div>
              <div class="text-2xl font-semibold text-stone-800">{domainPreview.valuationRange}</div>
            </div>
            <div class="text-[10px] text-terracotta font-semibold shrink-0">{domainPreview.tier}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
