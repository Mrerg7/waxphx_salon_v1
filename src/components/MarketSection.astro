---
import type { CollectionEntry } from 'astro:content';

interface Props {
  content: CollectionEntry<'site'>;
}

const { content } = Astro.props;
const { market } = content.data;
---

<section id="market" class="section-bg py-24 border-b border-terracotta/10">
  <div class="max-w-screen-xl mx-auto px-6">
    <div class="uppercase tracking-[3px] text-xs font-semibold text-terracotta mb-3">{market.label}</div>
    <h2 class="text-4xl sm:text-6xl font-display tracking-tighter leading-none mb-16 whitespace-pre-line text-stone-800">
      {market.title}
    </h2>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {market.stats.map((stat) => (
        <div class="glass rounded-3xl p-8 text-center">
          <div class="metric text-terracotta mb-2">{stat.value}</div>
          <div class="text-sm text-stone-500">{stat.label}</div>
          <div class="text-[11px] text-stone-400 mt-3 pt-3 border-t border-terracotta/10">{stat.highlight}</div>
        </div>
      ))}
    </div>

    <div class="max-w-3xl mx-auto text-center">
      <p class="text-lg text-stone-500 mb-2">{market.footnote}</p>
      <p class="text-sm text-terracotta font-semibold">{market.footnoteAccent}</p>
    </div>
  </div>
</section>
