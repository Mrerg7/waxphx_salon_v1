---
import type { CollectionEntry } from 'astro:content';

interface Props {
  content: CollectionEntry<'site'>;
}

const { content } = Astro.props;
const { faq } = content.data;
---

<section id="faq" class="max-w-screen-xl mx-auto px-6 py-20 sm:py-24 scroll-mt-24">
  <div class="max-w-3xl">
    <div class="uppercase tracking-[3px] text-xs font-semibold text-terracotta mb-3">{faq.label}</div>
    <h2 class="text-3xl sm:text-5xl font-display tracking-tighter leading-none mb-4 text-stone-800">
      {faq.title}
    </h2>
    <p class="text-lg text-stone-500 mb-12">{faq.subtitle}</p>
  </div>

  <div class="grid md:grid-cols-2 gap-5">
    {
      faq.items.map((item) => (
        <div class="glass rounded-3xl p-6 sm:p-7 h-full">
          <h3 class="font-semibold text-stone-800 text-base sm:text-lg mb-2.5 leading-snug flex gap-x-3">
            <svg class="w-5 h-5 text-terracotta shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{item.question}</span>
          </h3>
          <p class="text-sm sm:text-[15px] text-stone-500 leading-relaxed sm:pl-8">{item.answer}</p>
        </div>
      ))
    }
  </div>
</section>
