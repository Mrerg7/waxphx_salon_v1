---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found | waxphx.salon" noindex={true}>
  <main class="min-h-screen flex items-center justify-center bg-cream">
    <div class="text-center px-4">
      <h1 class="text-6xl font-display text-terracotta mb-4">404</h1>
      <p class="text-lg text-stone-500 mb-8">The page you are looking for does not exist.</p>
      <a href="/" class="inline-flex items-center gap-2 px-8 py-3 bg-terracotta text-white font-semibold rounded-xl hover:bg-terracotta/80 transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"></path>
        </svg>
        Return to Home
      </a>
    </div>
  </main>
</BaseLayout>
